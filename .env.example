# Higashi — copy to backend/.env and edit. Every value here is a default or a sample;
# none is a real credential. The application reads these names only — anything else in
# the file is rejected at startup, so do not add stray keys.

# ── Database ────────────────────────────────────────────────────────────────
# SQLite needs nothing installed and is the right choice for a single site.
DATABASE_URL=sqlite+aiosqlite:///./higashi.db
# Postgres, if you would rather:
# DATABASE_URL=postgresql+asyncpg://higashi:yourpassword@localhost:5432/higashi

# ── Identity ────────────────────────────────────────────────────────────────
# Replaced with a generated value on first start if left as-is. Changing it later
# signs everyone out and makes saved log-source secrets unreadable.
SECRET_KEY=changeme_generate_a_real_key
FIRST_RUN=true

# The first site you will track, and who administers this install.
SITE_DOMAIN=example.com
SITE_NAME=Example
ADMIN_EMAIL=you@example.com

# Where this dashboard is served from. Used for password-reset links, so it is the
# dashboard's own address — not a site you track.
DASHBOARD_URL=https://analytics.example.com

# ── Data retention ──────────────────────────────────────────────────────────
RAW_EVENT_RETENTION_DAYS=90

# ── AI, all optional ────────────────────────────────────────────────────────
# Higashi explains crawler activity with deterministic rules and no key at all.
# A key only adds the plain-language chat and model-written prose; the rules stay
# the ceiling either way.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AI_DEFAULT_MODEL=claude-haiku-4-5-20251001
AI_MONTHLY_BUDGET_USD=0

# Which provider writes the walk reading: local | byok | live
WALK_READING_PROVIDER=local
WALK_READING_MODEL=

# ── Pulling logs from another server, all optional ──────────────────────────
# Only needed if you import access logs over SSH/SFTP rather than using the tracker.
# Saved profiles are encrypted server-side; these are the bootstrap values.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=

# Which logs to pull, semicolon-separated. Each entry is
#     label|domain|/path/to/access.log
# and may carry its own credentials when one source differs from the rest:
#     label|domain|/path/to/access.log|username|password
# Leave empty to import by hand only. Example:
# LOG_SOURCES=My site|example.com|/var/log/nginx/example.access.log
LOG_SOURCES=

# ── Higashi Live, optional ──────────────────────────────────────────────────
# The paid hosted service. Leave LIVE_KEY empty to run entirely on your own box.
LIVE_KEY=
LIVE_URL=https://intel.cloudanalyst.net
LIVE_SITE_TYPE=other

# ---------------------------------------------------------------------------
# External IP geolocation. OFF, and off is the default.
#
# Set EXTERNAL_GEO=true and every visitor IP seen by the log importer and by the
# browser collector is sent to ip-api.com: a third party, in the United States,
# over plain HTTP, because their free tier offers no TLS. An IP address is
# personal data. Leave this off unless you have decided that trade is one you
# want to make, and tell your visitors if you turn it on.
#
# This is not covered by any other consent in Higashi. It is unrelated to
# Higashi Live, which is a separate paid service you enable with a key.
EXTERNAL_GEO=false
