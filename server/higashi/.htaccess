# SPA fallback for the Higashi dashboard at /higashi/.
# Real files (assets, proxy.php, etc.) are served as-is; everything else
# rewrites to /higashi/index.html so the React router handles the URL.

RewriteEngine On
RewriteBase /higashi/

# Don't rewrite real files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Don't rewrite the API proxy
RewriteRule ^api/proxy\.php$ - [L]

# Everything else under /higashi/ → index.html (React Router takes over)
RewriteRule ^ index.html [L]

# Long-cache hashed assets
<FilesMatch "\.(js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|webp|ico)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Never cache index.html (clients should always re-check)
<Files "index.html">
  Header set Cache-Control "no-cache, must-revalidate"
</Files>
